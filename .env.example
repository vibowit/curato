# ==========================================
# Simkl Recommender - Environment Configuration
# ==========================================

# Simkl API Credentials (https://simkl.com/settings/developer/)
# Client ID is required for API requests
SIMKL_CLIENT_ID=your_simkl_client_id_here
# Client Secret from Simkl Developer Portal
SIMKL_CLIENT_SECRET=your_simkl_client_secret_here
# OAuth access token for private watchlist/ratings access (can be generated via scripts/get_simkl_token.py)
SIMKL_USER_TOKEN=
# Simkl username or numeric ID (from your profile URL https://simkl.com/username)
SIMKL_USERNAME=

# Google Gemini API (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# TMDB API (The Movie Database) - for subsequent stages
TMDB_API_KEY=your_tmdb_api_key_here

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
